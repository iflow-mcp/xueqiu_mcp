        "type": "object",
        "properties": {
          "stock_code": {
            "type": "string",
            "description": "股票代码",
            "default": "SZ000002"
          },
          "days": {
            "type": "integer",
            "description": "天数",
            "default": 100
          }
        }
      }
    },
