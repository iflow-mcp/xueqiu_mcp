{
  "name": "雪球MCP",
  "description": "基于雪球API的MCP服务，提供股票数据查询功能，包括实时行情、K线数据、资金流向、财务数据、基金信息等40多个工具。支持股票行情查询、指数收益、深港通/沪港通北向数据、基金相关数据查询、关键词搜索股票代码等功能。",
  "serverConfig": "{\"mcpServers\":{\"xueqiu-mcp\":{\"command\":\"uvx\",\"args\":[\"iflow-mcp-xueqiu-mcp\"],\"env\":{\"XUEQIU_TOKEN\":\"您的雪球token\"}}}}",
  "tools": [
    {
      "name": "quotec",
      "description": "获取某支股票的行情数据",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stock_code": {
            "type": "string",
            "description": "股票代码",
            "default": "SZ000002"
          }
        }
      }
    },
    {
      "name": "quote_detail",
      "description": "获取某支股票的行情数据-详细",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stock_code": {
            "type": "string",
            "description": "股票代码",
            "default": "SZ000002"
          }
        }
      }
    },
    {
      "name": "pankou",
      "description": "获取实时分笔数据，可以实时取得股票当前报价和成交信息",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stock_code": {
            "type": "string",
            "description": "股票代码",
            "default": "SZ000002"
          }
        }
      }
    },
    {
      "name": "kline",
      "description": "获取K线数据。第二参数可制定从现在到N天前，默认100",
